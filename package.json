{
  "name": "srt-lint-mcp",
  "version": "0.0.1",
  "description": "MCP server that lints and safely fixes SubRip (.srt) subtitle files — timing, overlaps, CPS, line length, and numbering.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "srt-lint-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "glama.json",
    "smithery.yaml"
  ],
  "scripts": {
    "build": "tsc -p ./",
    "prepare": "npm run build",
    "test": "tsc -p ./ && node --test dist/test/*.test.js",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "srt",
    "subtitle",
    "lint",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/todanley/srt-lint-mcp"
  }
}
